{
	"name": "pl_ingest_carbon_intensity",
	"properties": {
		"activities": [
			{
				"name": "Copy Carbon Intensity API",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "effective_ingestion_date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"supportRFC5988": "true"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_carbon_intensity_api",
						"type": "DatasetReference",
						"parameters": {
							"ingestion_date": {
								"value": "@variables('effective_ingestion_date')",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adls_raw",
						"type": "DatasetReference",
						"parameters": {
							"ingestion_date": {
								"value": "@variables('effective_ingestion_date')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "effective_ingestion_date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "effective_ingestion_date",
					"value": {
						"value": "@if(\n    empty(pipeline().parameters.ingestion_date),\n    formatDateTime(addDays(utcNow(), -1), 'yyyy-MM-dd'),\n    pipeline().parameters.ingestion_date\n)",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"ingestion_date": {
				"type": "string"
			}
		},
		"variables": {
			"effective_ingestion_date": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-01T14:59:16Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}